# AI Memory Configuration
# See: http://aimemory.sh/pt-br/install/

# AI Memory API endpoint (if using managed instance)
# AI_MEMORY_ENDPOINT=https://api.aimemory.sh

# Local ai-memory database path (optional, for self-hosted)
# AI_MEMORY_DB=./ai-memory.db

# Enable context persistence across sessions
AI_MEMORY_ENABLED=true
