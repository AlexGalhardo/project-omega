{
  "permissions": {
    "allow": [
      "PowerShell(bun test)",
      "PowerShell(bun run build)",
      "PowerShell(bun run test)",
      "PowerShell(bun run check)",
      "PowerShell(bun run lint)",
      "PowerShell(bun run format)",
      "PowerShell(bun install --frozen-lockfile)",
      "PowerShell(cargo build)",
      "PowerShell(cargo test)",
      "PowerShell(cargo check)",
      "PowerShell(cargo clippy)",
      "PowerShell(cargo fmt)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git branch *)",
      "PowerShell(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git log *)",
      "Read(*)",
