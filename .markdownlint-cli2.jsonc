{
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    // Rust and PowerShell fences contain hard tabs (.editorconfig)
    "MD010": { "code_blocks": false },
    // Long lines are fine in prose and tables
    "MD013": false,
    // Keep a Changelog repeats "### Added" under each release
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD041": false,
    "MD046": { "style": "fenced" },
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", "target/**", "engine/bevy/**", "graphify-out/**", ".claude/skills/**", ".claude/agents/**", "PROMPT.md"]
}
