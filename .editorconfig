root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

# Formats whose tooling or spec expects spaces
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.svg]
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
end_of_line = crlf

# Vendored Bevy fork keeps upstream style
[engine/**]
indent_style = space
indent_size = 4
